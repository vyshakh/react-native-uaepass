{
  "$schema": "https://turbo.build/schema.json",
  "pipeline": {
    "build:android": {
      "inputs": [
        "package.json",
        "plugin",
        "app.plugin.js",
        "src/*.ts",
        "src/*.tsx",
        "example/package.json",
        "example/app.config.ts",
        "example/react-native.config.js",
        "android",
        "!android/build"
      ],
      "outputs": []
    },
    "build:ios": {
      "inputs": [
        "package.json",
        "plugin",
        "app.plugin.js",
        "src/*.ts",
        "src/*.tsx",
        "example/package.json",
        "example/app.config.ts",
        "example/react-native.config.js",
        "*.podspec",
        "ios",
        "!ios/build"
      ],
      "outputs": []
    }
  }
}
